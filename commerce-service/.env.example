PORT=5001

DB_NAME=commerce_service
DB_USER=root
DB_PASSWORD=laundry_dev_root_pw
DB_HOST=127.0.0.1
DB_PORT=3310
# Set to true in production, against a MySQL that has TLS configured
# (every managed cloud MySQL does) — local/dev MySQL here has no cert.
DB_SSL=false

CORS_ORIGIN=http://localhost:5000

# Shared secret only the gateway and these 5 services know. Downstream
# services reject any request that doesn't carry it — closes the gap
# where someone could skip the gateway and forge x-user-id/x-user-role
# by calling a service's port directly.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-shared-secret

# Cache + rate-limiter counters. Optional: with REDIS_URL unset the cache
# becomes a no-op (reads fall through to MySQL) and rate limiting falls back
# to per-process counters — the service still runs, just without either
# benefit. Port 6390 is offset from Tecnogex's redis-stack (8051).
REDIS_URL=redis://127.0.0.1:6390
# Key prefix so all 5 services can share one Redis without colliding.
CACHE_NAMESPACE=commerce

# Rate limiting is OFF in development (it trips constantly while building)
# and ON automatically under NODE_ENV=production. Set to true to exercise the
# real throttling behaviour locally.
RATE_LIMIT_ENABLED=false
