# THE environment switch. true on a laptop: hosted DATABASE_URL / DIRECT_DATABASE_URL
# are ignored (the DB_* vars below are used), docs on, rate limit off, CORS open,
# service URLs default to localhost, and any LOCAL_<NAME> replaces <NAME>.
# Absent or false is hosted mode, which render.yaml sets.
IS_LOCAL=true

PORT=5001

# Local docker-compose Postgres (see docker-compose.yml). One database with
# one schema per service — deliberately the same shape as the hosted
# environment, so local and deployed fail in the same ways.
DB_NAME=laundry_development
DB_USER=postgres
DB_PASSWORD=laundry_dev_root_pw
DB_HOST=127.0.0.1
DB_PORT=5442
# Managed Postgres always presents a certificate; the local container has
# none, so TLS is off here and on everywhere else.
DB_SSL=false

CORS_ORIGIN=http://localhost:5000

# Shared secret only the gateway and these 5 services know. Downstream
# services reject any request that doesn't carry it — closes the gap
# where someone could skip the gateway and forge x-user-id/x-user-role
# by calling a service's port directly.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-shared-secret

# Cache + rate-limiter counters. Optional: with REDIS_URL unset the cache
# becomes a no-op (reads fall through to Postgres) and rate limiting falls back
# to per-process counters — the service still runs, just without either
# benefit. Port 6390 is offset from Tecnogex's redis-stack (8051).
REDIS_URL=redis://127.0.0.1:6390
# Key prefix so all 5 services can share one Redis without colliding.
CACHE_NAMESPACE=commerce

# Rate limiting is OFF in development (it trips constantly while building)
# and ON automatically under NODE_ENV=production. Set to true to exercise the
# real throttling behaviour locally.
RATE_LIMIT_ENABLED=false

# --- Hosted Postgres (Supabase/Render) ---
# When set, this takes precedence over DB_HOST/DB_NAME/etc above.
#
# Use Supabase's POOLED string (port 6543). Free-tier hosts open and drop
# connections constantly, and five services against the direct port exhaust
# its connection limit within minutes.
DATABASE_URL=
# The DIRECT string (port 5432), used ONLY by `npm run db:migrate`. Prisma
# Migrate takes a Postgres advisory lock, and a transaction-mode pooler hands
# each statement to a different backend — so the lock would be taken on one
# connection and released on another, leaving migrations hung or half
# applied. Optional locally, where there is no pooler at all.
DIRECT_DATABASE_URL=
# Each service gets its own Postgres schema inside the one free database,
# preserving the "no service reads another's tables" boundary.
DB_SCHEMA=commerce
