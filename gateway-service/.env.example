PORT=5000

DB_NAME=gateway_service
DB_USER=root
DB_PASSWORD=laundry_dev_root_pw
DB_HOST=127.0.0.1
DB_PORT=3310
# Set to true in production, against a MySQL that has TLS configured
# (every managed cloud MySQL does) — local/dev MySQL here has no cert.
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

COMMERCE_SERVICE_URL=http://localhost:5001
LOGISTICS_SERVICE_URL=http://localhost:5002
FINANCE_SERVICE_URL=http://localhost:5003
GROWTH_SERVICE_URL=http://localhost:5004

# Shared secret only the gateway and these 5 services know. Downstream
# services reject any request that doesn't carry it — closes the gap
# where someone could skip the gateway and forge x-user-id/x-user-role
# by calling a service's port directly.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-shared-secret

# Only read by `npm run seed:super-admin` (see scripts/seed-super-admin.mjs)
# to bootstrap the very first super_admin account — never read by the
# running server itself. Every other admin/staff/driver account after
# that is created via POST /auth/admin-users (super_admin-only).
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=0000000000

# ---------------------------------------------------------------------
# Social login (POST /auth/login/oauth) — NOT IMPLEMENTED YET, these are
# empty slots so the credentials have somewhere to live when it is built.
#
# TEMPORARY: borrowing Tecnogex's Google credentials (its backend reads
# the same values as GOOGLE_AUTH_CLIENT_ID / GOOGLE_AUTH_CLIENT_SECRET).
# Copy the values across by hand — they are not in source control on
# either side. To be replaced with this project's own Google Cloud
# project before anything reaches real users, because:
#   - the consent screen shows the OWNING project's name, so laundry
#     customers would see "Tecnogex" when signing in;
#   - revoking or rotating Tecnogex's secret silently breaks this too.
#
# Reusing the client id is NOT sufficient on its own: Google rejects any
# redirect_uri that isn't registered against that client. Whoever owns
# the Tecnogex Google Cloud project must add this gateway's callback URL
# to its "Authorized redirect URIs", or every attempt fails with
# redirect_uri_mismatch.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Apple: Tecnogex has APPLE_CLIENT_ID set and passport-apple installed,
# but Apple sign-in is NOT actually working there — its frontend still
# shows "Apple login is not available yet". So there is no proven config
# to copy; this needs a real Apple Developer setup (Service ID, Key ID,
# Team ID and a .p8 private key) when Apple login is actually built.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Cache + rate-limiter counters. Optional: with REDIS_URL unset the cache
# becomes a no-op (reads fall through to MySQL) and rate limiting falls back
# to per-process counters — the service still runs, just without either
# benefit. Port 6390 is offset from Tecnogex's redis-stack (8051).
REDIS_URL=redis://127.0.0.1:6390
# Key prefix so all 5 services can share one Redis without colliding.
CACHE_NAMESPACE=gateway

# Rate limiting is OFF in development (it trips constantly while building)
# and ON automatically under NODE_ENV=production. Set to true to exercise the
# real throttling behaviour locally.
RATE_LIMIT_ENABLED=false

# ---------------------------------------------------------------------
# OTP delivery. Both are optional — with these unset the code is written
# to the server log instead, which is how local dev works without a
# provider account or a per-message bill.
#
# TEMPORARY: these are Tecnogex's credentials (its backend reads the same
# variable names). Copy the values across by hand — they are not in source
# control on either side. Replace with this project's own accounts before
# launch: revoking or rotating Tecnogex's keys silently breaks LOC too,
# and the SMS spend lands on Tecnogex's bill.

# SMS — TransmitSMS (https://transmitsms.com), HTTP Basic auth.
TRANSMIT_SMS_API_KEY=
TRANSMIT_SMS_API_SECRET=
TRANSMIT_SMS_FROM_NUMBER=

# Email — SMTP via nodemailer.
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Defaults to EMAIL_USER when unset.
EMAIL_FROM=
