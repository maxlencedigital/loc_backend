PORT=5000

# Local docker-compose Postgres (see docker-compose.yml). One database with
# one schema per service — deliberately the same shape as the hosted
# environment, so local and deployed fail in the same ways.
DB_NAME=laundry_development
DB_USER=postgres
DB_PASSWORD=laundry_dev_root_pw
DB_HOST=127.0.0.1
DB_PORT=5442
# Managed Postgres always presents a certificate; the local container has
# none, so TLS is off here and on everywhere else.
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

COMMERCE_SERVICE_URL=http://localhost:5001
LOGISTICS_SERVICE_URL=http://localhost:5002
FINANCE_SERVICE_URL=http://localhost:5003
GROWTH_SERVICE_URL=http://localhost:5004

# Shared secret only the gateway and these 5 services know. Downstream
# services reject any request that doesn't carry it — closes the gap
# where someone could skip the gateway and forge x-user-id/x-user-role
# by calling a service's port directly.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-shared-secret

# Only read by `npm run seed:super-admin` (see scripts/seed-super-admin.mjs)
# to bootstrap the very first super_admin account — never read by the
# running server itself. Every other admin/staff/driver account after
# that is created via POST /auth/admin-users (super_admin-only).
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=0000000000

# ---------------------------------------------------------------------
# Social login (POST /auth/login/oauth). Google and Facebook are implemented.
#
# The client sends only a provider token. The gateway verifies it against the
# provider server-side and reads the email and name out of the verified
# response — it never trusts a profile sent by the client, or anyone could
# sign in as any email simply by typing it.
#
# --- Google ---
# ACCEPTS A COMMA-SEPARATED LIST. Google issues a separate client id per
# platform, so the web app, the Android app and the iOS app each sign their
# tokens with a different `aud`. List every one the apps actually use, or
# tokens from the missing platforms are rejected as "issued for a different
# application":
#   GOOGLE_AUTH_CLIENT_ID=123-web.apps.googleusercontent.com,456-android.apps.googleusercontent.com
#
# TEMPORARY: borrowing Tecnogex's Google credentials (its backend reads the
# same variable names). Copy the values across by hand — they are not in
# source control on either side. To be replaced with this project's own
# Google Cloud project before anything reaches real users, because:
#   - the consent screen shows the OWNING project's name, so laundry
#     customers would see "Tecnogex" when signing in;
#   - revoking or rotating Tecnogex's secret silently breaks this too.
GOOGLE_AUTH_CLIENT_ID=
# Not read by this flow. Verifying an ID token needs only the client id; the
# secret is for the server-side authorization-code exchange, which this
# gateway does not perform. Kept as a slot for whenever that is added.
GOOGLE_AUTH_CLIENT_SECRET=

# --- Facebook ---
# BOTH are required. The app access token used to call debug_token is
# literally "<app id>|<app secret>", and debug_token is the step that proves
# the user token was issued to THIS app — without it, any valid Facebook
# token from any app would be accepted.
#
# Unlike Google, Facebook uses ONE app across web, Android and iOS, so this
# is a single value rather than a list.
FACEBOOK_AUTH_APP_ID=
FACEBOOK_AUTH_APP_SECRET=

# Apple sign-in is not implemented; its endpoint refuses rather than accepting
# tokens it cannot verify. Add its vars when the Apple Developer setup exists.

# Cache + rate-limiter counters. Optional: with REDIS_URL unset the cache
# becomes a no-op (reads fall through to Postgres) and rate limiting falls back
# to per-process counters — the service still runs, just without either
# benefit. Port 6390 is offset from Tecnogex's redis-stack (8051).
REDIS_URL=redis://127.0.0.1:6390
# Key prefix so all 5 services can share one Redis without colliding.
CACHE_NAMESPACE=gateway

# Rate limiting is OFF in development (it trips constantly while building)
# and ON automatically under NODE_ENV=production. Set to true to exercise the
# real throttling behaviour locally.
RATE_LIMIT_ENABLED=false

# ---------------------------------------------------------------------
# OTP delivery. Both are optional — with these unset the code is written
# to the server log instead, which is how local dev works without a
# provider account or a per-message bill.
#
# TEMPORARY: these are Tecnogex's credentials (its backend reads the same
# variable names). Copy the values across by hand — they are not in source
# control on either side. Replace with this project's own accounts before
# launch: revoking or rotating Tecnogex's keys silently breaks LOC too,
# and the SMS spend lands on Tecnogex's bill.

# SMS — TransmitSMS (https://transmitsms.com), HTTP Basic auth.
TRANSMIT_SMS_API_KEY=
TRANSMIT_SMS_API_SECRET=
TRANSMIT_SMS_FROM_NUMBER=

# Email — SMTP via nodemailer.
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Defaults to EMAIL_USER when unset.
EMAIL_FROM=

# --- Hosted Postgres (Supabase/Render) ---
# When set, this takes precedence over DB_HOST/DB_NAME/etc above.
#
# Use Supabase's POOLED string (port 6543). Free-tier hosts open and drop
# connections constantly, and five services against the direct port exhaust
# its connection limit within minutes.
DATABASE_URL=
# The DIRECT string (port 5432), used ONLY by `npm run db:migrate`. Prisma
# Migrate takes a Postgres advisory lock, and a transaction-mode pooler hands
# each statement to a different backend — so the lock would be taken on one
# connection and released on another, leaving migrations hung or half
# applied. Optional locally, where there is no pooler at all.
DIRECT_DATABASE_URL=
# Each service gets its own Postgres schema inside the one free database,
# preserving the "no service reads another's tables" boundary.
DB_SCHEMA=gateway

# Serve Swagger even under NODE_ENV=production. For the hosted DEV/STAGING
# environment only, so the frontend and app teams keep their docs. Never set
# this on a real production deployment.
ENABLE_DOCS=true
